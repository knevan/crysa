{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "jsx": "preserve",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@/*": ["./*"],
      "*": ["./deps/*", "./node_modules/*"]
    }
  },
  "include": [
    "./assets/js/**/*",
    "./assets/vue/**/*",
    "./lib/crysa_web/**/*"
  ],
  "exclude": [
    "node_modules",
    "deps"
  ]
}
