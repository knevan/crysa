<!DOCTYPE html>
<html lang="en" data-theme={assigns[:theme]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Crysa" suffix=" · Crysa" phx-no-format>
      {assigns[:page_title]}
    </.live_title>
    <PhoenixVite.Components.assets
      names={["js/app.js", "css/app.css"]}
      manifest={{:crysa, "priv/static/.vite/manifest.json"}}
      dev_server={PhoenixVite.Components.has_vite_watcher?(CrysaWeb.Endpoint)}
      to_url={fn p -> static_url(@conn, p) end}
    />
    <script>
      (() => {
        const systemTheme = () =>
          matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";

        const setTheme = (theme) => {
          if (theme === "system") {
            localStorage.removeItem("phx:theme");
            document.documentElement.setAttribute("data-theme", systemTheme());
            document.documentElement.setAttribute("data-theme-source", "system");
          } else {
            localStorage.setItem("phx:theme", theme);
            document.documentElement.setAttribute("data-theme", theme);
            document.documentElement.setAttribute("data-theme-source", "user");
          }
        };
        if (!document.documentElement.hasAttribute("data-theme")) {
          setTheme(localStorage.getItem("phx:theme") || "system");
        }
        window.addEventListener(
          "storage",
          (e) => e.key === "phx:theme" && setTheme(e.newValue || "system")
        );
        window.addEventListener("phx:set-theme", (e) => setTheme(e.target.dataset.phxTheme));

        matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (e) => {
          if (document.documentElement.getAttribute("data-theme-source") === "system") {
            document.documentElement.setAttribute("data-theme", systemTheme());
          }
        });
      })();
    </script>
  </head>
  <body class="min-h-screen bg-base-200">
    <.flash_messages />
    <nav class="bg-base-100 shadow">
      <div class="navbar max-w-245 mx-auto w-full px-2">
        <div class="navbar-start">
          <a href={~p"/"} class="btn btn-ghost text-xl">
            Crysa
          </a>
        </div>
        <div class="navbar-center hidden lg:flex">
          <ul class="menu menu-horizontal px-1 text-sm">
            <li><a href={~p"/series"}>Browse</a></li>
            <li><a href={~p"/popular"}>Popular</a></li>
            <li :if={moderator?(@current_user)}><a href={~p"/admin"}>Admin Panel</a></li>
          </ul>
        </div>
        <div class="navbar-end">
          <!-- Notification bell: same-page dropdown, live in every page via a
               sticky child LiveView. Guests render nothing. -->
          {live_render(@conn, CrysaWeb.Live.NotificationBellLive,
            id: "notification-bell",
            session: %{},
            sticky: true
          )}
          <!-- Desktop: Sign in / @admin, hidden on mobile -->
          <div :if={@current_user} class="hidden lg:flex items-center gap-2">
            <div class="dropdown dropdown-end">
              <div tabindex="0" role="button" class="btn btn-ghost">
                @{@current_user.username}
              </div>
              <ul
                tabindex="0"
                class="dropdown-content menu bg-white rounded-box z-10 w-52 p-2 shadow"
              >
                <li><a href={~p"/users/profile"}>Profile</a></li>
                <li><a href={~p"/bookmarks"}>Bookmarks</a></li>
                <li><a href={~p"/users/settings"}>Settings</a></li>
                <li :if={moderator?(@current_user)}>
                  <a href={~p"/admin"}>Dashboard</a>
                </li>
                <li>
                  <.form for={%{}} action={~p"/auth/logout"} method="delete" class="contents">
                    <.button type="submit">Log out</.button>
                  </.form>
                </li>
              </ul>
            </div>
          </div>
          <div :if={!@current_user} class="hidden lg:flex items-center gap-2">
            <a
              href={~p"/auth/login"}
              class="text-sm font-medium hover:text-primary hover:underline underline-offset-4 transition-colors"
            >
              Sign in
            </a>
          </div>
          <!-- Mobile: hamburger on right, contains browse + manga updates + profile + settings -->
          <div class="dropdown dropdown-end lg:hidden">
            <div tabindex="0" role="button" class="btn btn-ghost btn-sm">
              <.icon name="hero-bars-3" class="h-5 w-5" />
            </div>
            <ul
              tabindex="0"
              class="menu menu-sm dropdown-content bg-white rounded-box z-50 mt-1 w-52 p-2 shadow-xl"
            >
              <li><a href={~p"/series"}>Browse</a></li>
              <li :if={moderator?(@current_user)}><a href={~p"/admin"}>Admin Panel</a></li>
              <li :if={@current_user}>
                <a href={~p"/notifications"}>
                  Notifications
                  <span :if={@unread_notifications_count > 0} class="badge badge-error badge-sm">
                    {if @unread_notifications_count > 99,
                      do: "99+",
                      else: @unread_notifications_count}
                  </span>
                </a>
              </li>
              <li :if={@current_user}><a href={~p"/users/profile"}>Profile</a></li>
              <li :if={@current_user}><a href={~p"/bookmarks"}>Bookmarks</a></li>
              <li :if={@current_user}><a href={~p"/users/settings"}>Settings</a></li>
              <li :if={@current_user}>
                <.form for={%{}} action={~p"/auth/logout"} method="delete" class="contents">
                  <.button type="submit" variant="ghost" class="w-full justify-start font-normal">Log out</.button>
                </.form>
              </li>
              <li :if={!@current_user}><a href={~p"/auth/login"}>Sign in</a></li>
            </ul>
          </div>
        </div>
      </div>
    </nav>
    <main class="max-w-245 mx-auto w-full p-6">
      {@inner_content}
    </main>
  </body>
</html>
