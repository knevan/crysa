<Layouts.flash_group flash={@flash} />
<div class="space-y-6">
  <section aria-label="Trending series">
    <.vue v-component="TrendingSection" v-ssr={true} initialPeriod="day" lists={@trending} />
  </section>

  <div class="flex flex-wrap items-center justify-between gap-4">
    <h1 class="text-2xl font-bold">New Series</h1>
    <a href={~p"/series"} class="link">Browse all series</a>
  </div>

  <div :if={@series == []} class="card bg-base-100 p-10 text-center shadow">
    <p class="text-base-content/60">No series yet.</p>
  </div>

  <div class="grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-4">
    <.series_card :for={series <- @series} series={series} />
  </div>

  <.pagination pagination={@pagination} path="/" params={@params} />
</div>
