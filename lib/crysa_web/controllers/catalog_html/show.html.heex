<Layouts.flash_group flash={@flash} />
<div class="space-y-6">
  <div class="card bg-base-100 shadow">
    <div class="card-body gap-4">
      <div class="flex flex-wrap items-start gap-6">
        <figure class="w-40 shrink-0 overflow-hidden rounded-box">
          <img
            src={@series.cover_url || ~p"/images/placeholder-cover.svg"}
            alt={@series.title}
            class="aspect-[3/4] w-full object-cover"
          />
        </figure>

        <div class="min-w-0 flex-1 space-y-3">
          <div class="flex flex-wrap items-center gap-3">
            <h1 class="text-2xl font-bold">{@series.title}</h1>
            <span class="badge badge-outline">{@series.publication_status}</span>
          </div>

          <div class="flex flex-wrap gap-x-6 gap-y-1 text-sm text-base-content/70">
            <span>{@series.chapter_count} chapters</span>
            <span>{@series.view_count} views</span>
            <span>{@series.bookmark_count} bookmarks</span>
          </div>

          <div :if={@series.categories != []} class="flex flex-wrap gap-1">
            <a
              :for={category <- @series.categories}
              href={~p"/series?category=#{category.name}"}
              class="badge badge-sm badge-outline"
            >
              {category.name}
            </a>
          </div>

          <div :if={@series.authors != []} class="text-sm">
            <span class="text-base-content/60">By </span>
            <span :for={author <- @series.authors} class="text-sm">
              {author.name}
            </span>
          </div>

          <p :if={@series.description} class="max-w-2xl text-sm leading-6 text-base-content/80">
            {@series.description}
          </p>

          <div class="flex gap-2 pt-2">
            <a
              :if={@latest_chapter}
              href={~p"/series/#{@series.slug}/#{@latest_chapter.chapter_key}"}
              class="btn btn-primary btn-sm"
            >
              Read latest chapter
            </a>
            <a href={~p"/series"} class="btn btn-outline btn-sm">Back to browse</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="card bg-base-100 shadow">
    <div class="card-body gap-2">
      <h2 class="text-lg font-semibold">Chapters</h2>

      <div :if={@chapters == []} class="py-6 text-center text-sm text-base-content/60">
        No chapters available yet.
      </div>

      <ul class="divide-y divide-base-200">
        <li :for={chapter <- @chapters}>
          <a
            href={~p"/series/#{@series.slug}/#{chapter.chapter_key}"}
            class="flex items-center justify-between py-3 hover:bg-base-200/60 px-2 -mx-2 rounded"
          >
            <span>
              <span class="font-medium">Chapter {chapter.display_number}</span>
              <span :if={chapter.title} class="ml-2 text-sm text-base-content/60">
                {chapter.title}
              </span>
            </span>
            <span class="text-xs text-base-content/50">{format_date(chapter.published_at)}</span>
          </a>
        </li>
      </ul>

      <div class="flex justify-center pt-2">
        <.pagination pagination={@pagination} path={~p"/series/#{@series.slug}"} params={%{}} />
      </div>
    </div>
  </div>
</div>
