<Layouts.flash_group flash={@flash} />
<div class="space-y-6">
  <div class="flex flex-wrap items-center justify-between gap-4">
    <h1 class="text-2xl font-bold">Browse Series</h1>
    <a href={~p"/tags"} class="link">Browse by tag</a>
  </div>

  <.form
    for={%{}}
    action={~p"/series"}
    method="get"
    class="card bg-base-100 p-4 shadow"
  >
    <div class="flex flex-wrap items-center gap-3">
      <input
        type="search"
        name="q"
        value={@params["q"]}
        placeholder="Search by title..."
        class="input input-bordered input-sm flex-1 min-w-48"
      />
      <select name="sort" class="select select-bordered select-sm">
        <option value="new" selected={@params["sort"] in [nil, "new"]}>Newest</option>
        <option value="most_viewed" selected={@params["sort"] == "most_viewed"}>
          Most viewed
        </option>
        <option value="latest_updates" selected={@params["sort"] == "latest_updates"}>
          Latest updates
        </option>
        <option value="title" selected={@params["sort"] == "title"}>Title</option>
      </select>
      <select name="publication_status" class="select select-bordered select-sm">
        <option value="">All statuses</option>
        <option
          :for={status <- ["ongoing", "completed", "hiatus", "discontinued"]}
          value={status}
          selected={@params["publication_status"] == status}
        >
          {String.capitalize(status)}
        </option>
      </select>
      <button type="submit" class="btn btn-primary btn-sm">Search</button>
    </div>

    <div class="mt-3 flex flex-wrap gap-6">
      <fieldset>
        <legend class="text-xs font-semibold uppercase tracking-wide text-base-content/60">
          Include categories
        </legend>
        <div class="flex flex-wrap gap-2">
          <label
            :for={{category, count} <- @categories}
            class="label cursor-pointer gap-1"
          >
            <input
              type="checkbox"
              name="category"
              value={category.name}
              checked={category.name in included_categories(@params)}
              class="checkbox checkbox-xs"
            />
            <span class="label-text text-sm">{category.name} ({count})</span>
          </label>
        </div>
      </fieldset>

      <fieldset>
        <legend class="text-xs font-semibold uppercase tracking-wide text-base-content/60">
          Exclude categories
        </legend>
        <div class="flex flex-wrap gap-2">
          <label
            :for={{category, _count} <- @categories}
            class="label cursor-pointer gap-1"
          >
            <input
              type="checkbox"
              name="exclude_category"
              value={category.name}
              checked={category.name in excluded_categories(@params)}
              class="checkbox checkbox-xs"
            />
            <span class="label-text text-sm">{category.name}</span>
          </label>
        </div>
      </fieldset>
    </div>
  </.form>

  <div :if={@series == []} class="card bg-base-100 p-10 text-center shadow">
    <p class="text-base-content/60">No series match your filters.</p>
  </div>

  <div class="grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-4">
    <.series_card :for={series <- @series} series={series} />
  </div>

  <.pagination pagination={@pagination} path="/series" params={@params} />
</div>
